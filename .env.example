# ── Turso (libSQL) database ──────────────────────────────────────────────────
# Sign up free at https://turso.tech — no credit card required.
# 1. turso db create urt-platform
# 2. turso db show urt-platform   → copy the URL below
# 3. turso db tokens create urt-platform → copy the auth token below
DATABASE_URL=libsql://your-db-name.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# ── Admin panel ──────────────────────────────────────────────────────────────
# Set these to real secret values in Vercel → Settings → Environment Variables.
# If either is left blank the admin panel refuses all login attempts.
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_JWT_SECRET=choose-a-long-random-string-for-jwt-signing

# ── OAuth (optional — exam taking does NOT require login) ────────────────────
# Only needed if you re-enable the OAuth login flow in src/pages/Login.tsx.
# Leave blank to use the built-in guest-name flow instead.
APP_ID=
APP_SECRET=
AUTH_URL=
OPEN_URL=
OWNER_UNION_ID=

# ── Frontend build-time variables ────────────────────────────────────────────
# These are read by Vite at build time (must be prefixed VITE_).
# Leave blank unless you re-enable OAuth login.
VITE_AUTH_URL=
VITE_APP_ID=
